});

// fetch schedule list with pagination
router.route("/fetchScheduleList").get(async (req, res) => {
  try {
    const page = parseInt(req.query.page) || 1;
    const limit = parseInt(req.query.limit) || 10;
    const offset = (page - 1) * limit;

    const { count, rows } = await ScheduleModel.findAndCountAll({
      where: {
        isDeleted: 0,
      },
      include: [
        {
          model: ScheduleInvoiceList,
          as: "sil_schedule_id",
          include: [
            {
              model: BatchEntryMain,
              as: "sil_batch_entry_id",
            },
            {
              model: SalesInvoice,
              as: "sil_sales_invoice_id",
              include: [
                {
                  model: Customer,
                },
              ],
            },
          ],
        },

        {
          model: MasterList,
          as: "sm_created_by",
        },
        {
          model: MasterList,
          as: "sm_approved_by",
        },
        {
          model: MasterList,
          as: "sm_rejected_by",
        },
      ],
      order: [["delivery_date", "ASC"]],
      limit: limit,
      offset: offset,
    });

    const data = rows.map((row) => row.get({ plain: true }));

    return res.status(200).json({
      totalItems: count,
      totalPages: Math.ceil(count / limit),
      currentPage: page,
      success: true,
      data: data,
    });
  } catch (error) {
    console.error("Detailed error:", error);
    return res.status(500).json({
      message: "Internal server error",
      error: error.message,
    });
  }
});

